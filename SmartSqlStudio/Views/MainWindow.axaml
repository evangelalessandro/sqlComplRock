<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartSqlStudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="using:AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="SmartSqlStudio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Smart SQL Studio - Advanced SSMS Alternative"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#6e6e6e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <!-- Connection Panel -->
        <Border Grid.Row="0" Background="#1e1e1e" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" 
                  HorizontalAlignment="Stretch">
                
                <!-- Server Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" 
                           VerticalAlignment="Center" Margin="0,0,10,10"
                           Foreground="#cccccc"/>
                <TextBox Grid.Row="0" Grid.Column="1" 
                         Text="{Binding ServerName}" 
                         Watermark="Server name"
                         MinWidth="200" Margin="0,0,10,10"/>

                <!-- Database Name -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Database:" 
                           VerticalAlignment="Center" Margin="0,0,10,10"
                           Foreground="#cccccc"/>
                <TextBox Grid.Row="0" Grid.Column="3" 
                         Text="{Binding DatabaseName}" 
                         Watermark="Database name"
                         MinWidth="150" Margin="0,0,10,10"/>

                <!-- Auth Type -->
                <CheckBox Grid.Row="0" Grid.Column="4" 
                          Content="Windows Auth"
                          IsChecked="{Binding UseWindowsAuthentication}"
                          Margin="0,0,10,10"
                          Foreground="#cccccc"/>

                <!-- Test Connection Button -->
                <Button Grid.Row="0" Grid.Column="5" 
                        Content="Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        Classes="secondary"
                        Margin="0,0,10,10"
                        IsEnabled="{Binding !IsExecuting}"/>

                <!-- Execute Button -->
                <Button Grid.Row="0" Grid.Column="6" 
                        Content="▶ Execute Query"
                        Command="{Binding ExecuteQueryCommand}"
                        Classes="primary"
                        Margin="0,0,0,10"
                        IsEnabled="{Binding !IsExecuting}"/>

                <!-- Connection String -->
                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                         Text="{Binding ConnectionString}"
                         Watermark="Connection String (auto-generated or paste custom)"
                         Margin="0,0,0,5"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300" Margin="0,0,0,10">
            
            <!-- Query Editor -->
            <Border Grid.Column="0" Background="#1e1e1e" CornerRadius="8" Padding="10">
                <DockPanel>
                    <!-- Toolbar -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="SQL Query Editor" 
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#ffffff"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>
                        <Button Content="📋 Clear" 
                                Command="{Binding ClearQueryCommand}"
                                Classes="secondary"
                                Padding="10,5"
                                Margin="0,0,10,0"/>
                        <Button Content="💾 Save Snippet" 
                                Command="{Binding SaveSnippetCommand}"
                                Classes="secondary"
                                Padding="10,5"/>
                    </StackPanel>

                    <!-- Code Editor with IntelliSense -->
                    <avalonedit:TextEditor 
                        x:Name="SqlEditor"
                        SyntaxHighlighting="SQL"
                        ShowLineNumbers="True"
                        FontFamily="Consolas, 'Courier New', monospace"
                        FontSize="14"
                        Background="#1e1e1e"
                        Foreground="#d4d4d4"
                        Text="{Binding SqlQuery, Mode=TwoWay}"
                        WordWrap="False"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <!-- Snippets Panel -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="8" Padding="10" Margin="10,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📑 Code Snippets" 
                               FontSize="16" FontWeight="Bold"
                               Foreground="#ffffff"
                               Margin="0,0,0,10"/>
                    
                    <!-- Search Box -->
                    <TextBox DockPanel.Dock="Top" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="🔍 Search snippets..."
                             Margin="0,0,0,10"
                             Classes="search"/>
                    
                    <!-- Snippets List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Snippets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#333337" CornerRadius="4" Padding="10" Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Bold" 
                                                       Foreground="#569cd6"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding Description}" 
                                                       Foreground="#9cdcfe"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,5"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}" 
                                                           Background="#0078D4"
                                                           Foreground="White"
                                                           Padding="5,2"
                                                           CornerRadius="3"
                                                           FontSize="10"/>
                                                <Button Content="Insert" 
                                                        Click="OnInsertSnippetClick"
                                                        Classes="primary"
                                                        Padding="8,4"
                                                        Margin="10,0,0,0"
                                                        FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Results Panel -->
        <Border Grid.Row="2" Background="#1e1e1e" CornerRadius="8" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📊 Results" 
                               FontSize="16" FontWeight="Bold"
                               Foreground="#ffffff"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="12"
                               Foreground="#888888"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Results Grid -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding QueryResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Error Message -->
                                    <Border IsVisible="{Binding HasError}"
                                            Background="#5a1d1d" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding ErrorMessage}" 
                                                   Foreground="#f48771"/>
                                    </Border>

                                    <!-- Success Info -->
                                    <Border IsVisible="{Binding !HasError}" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="#4ec9b0">
                                                <Run Text="✓ "/>
                                                <Run Text="{Binding RowCount}"/>
                                                <Run Text=" rows"/>
                                                <Run Text=" in "/>
                                                <Run Text="{Binding ExecutionTime.TotalMilliseconds, StringFormat={}{0:F2}ms}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Data Grid Placeholder -->
                                    <Border IsVisible="{Binding !HasError}"
                                            Background="#2d2d30" CornerRadius="4" Padding="10">
                                        <StackPanel>
                                            <!-- Column Headers -->
                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0078D4" 
                                                                Padding="15,8" 
                                                                Margin="0,0,1,0"
                                                                CornerRadius="3,3,0,0">
                                                            <TextBlock Text="{Binding}" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Sample Rows Display -->
                                            <TextBlock Foreground="#888888" 
                                                       FontStyle="Italic"
                                                       Text="(Full data grid would display here in production)"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
