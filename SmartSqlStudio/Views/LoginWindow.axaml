<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartSqlStudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="SmartSqlStudio.Views.LoginWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Smart SQL Studio - Login"
        Width="500" Height="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    
    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Styles>
    
    <Grid RowDefinitions="Auto,*" Margin="30">
        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
            <TextBlock Text="🔐 Smart SQL Studio" 
                       FontSize="28" FontWeight="Bold"
                       Foreground="#0078D4"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Connessione a SQL Server" 
                       FontSize="16"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Login Form -->
        <Border Grid.Row="1" Background="#1e1e1e" CornerRadius="8" Padding="25">
            <StackPanel>
                <!-- Server Name -->
                <TextBlock Classes="label" Text="Server Name:"/>
                <TextBox Text="{Binding ServerName}" 
                         Watermark="es. localhost\\SQLEXPRESS o server.domain.com"/>
                
                <!-- Database Name -->
                <TextBlock Classes="label" Text="Database (opzionale):"/>
                <TextBox Text="{Binding DatabaseName}" 
                         Watermark="es. master o nome database"/>
                
                <!-- Authentication Type -->
                <TextBlock Classes="label" Text="Autenticazione:" Margin="0,10,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton Content="Windows Authentication" 
                                 IsChecked="{Binding UseWindowsAuthentication}"
                                 GroupName="AuthType"
                                 Foreground="#cccccc"
                                 Margin="0,0,20,0"/>
                    <RadioButton Content="SQL Server Authentication" 
                                 IsChecked="{Binding !UseWindowsAuthentication}"
                                 GroupName="AuthType"
                                 Foreground="#cccccc"/>
                </StackPanel>
                
                <!-- Username & Password (visible only for SQL Auth) -->
                <StackPanel IsVisible="{Binding !UseWindowsAuthentication}">
                    <TextBlock Classes="label" Text="Username:"/>
                    <TextBox Text="{Binding Username}" 
                             Watermark="SQL username"/>
                    
                    <TextBlock Classes="label" Text="Password:"/>
                    <TextBox Text="{Binding Password}" 
                             Watermark="SQL password"
                             PasswordChar="•"/>
                </StackPanel>
                
                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Connetti" 
                            Command="{Binding ConnectCommand}"
                            Classes="primary"
                            IsEnabled="{Binding !IsExecuting}"/>
                    <Button Content="Annulla" 
                            Command="{Binding CloseLoginCommand}"
                            Background="#6e6e6e"
                            Foreground="White"
                            Padding="20,10"
                            CornerRadius="4"
                            FontSize="14"
                            Margin="15,0,0,0"
                            IsEnabled="{Binding !IsExecuting}"/>
                </StackPanel>
                
                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" 
                           HorizontalAlignment="Center"
                           Foreground="#f48771"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
