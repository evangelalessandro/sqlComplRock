<Window x:Class="SmartSQLStudio.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart SQL Studio - Login" 
        Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
			<TextBlock Text="🗄️ Smart SQL Studio" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"/>
			<TextBlock Text="Connessione a SQL Server" 
                       FontSize="14"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
		</StackPanel>

		<!-- Form -->
		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Server -->
			<TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,10,15"/>
			<ComboBox Grid.Row="0" Grid.Column="1" x:Name="ServerComboBox" Margin="0,0,0,15">
				<ComboBoxItem Content="localhost"/>
				<ComboBoxItem Content="."/>
				<ComboBoxItem Content="(local)"/>
				<ComboBoxItem Content="127.0.0.1"/>
				<ComboBoxItem IsEnabled="True"/>
			</ComboBox>

			<!-- Database -->
			<TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,10,15"/>
			<TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabaseTextBox" Text="master" Margin="0,0,0,15"/>

			<!-- Autenticazione -->
			<TextBlock Grid.Row="2" Grid.Column="0" Text="Autenticazione:" VerticalAlignment="Center" Margin="0,0,10,15"/>
			<ComboBox Grid.Row="2" Grid.Column="1" x:Name="AuthComboBox" Margin="0,0,0,15">
				<ComboBoxItem Content="Windows Authentication"/>
				<ComboBoxItem Content="SQL Server Authentication"/>
			</ComboBox>

			<!-- Username -->
			<TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,15"/>
			<TextBox Grid.Row="3" Grid.Column="1" x:Name="UsernameTextBox" Margin="0,0,0,15"/>

			<!-- Password -->
			<TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,15"/>
			<PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,15"/>

			<!-- Status -->
			<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                       x:Name="StatusTextBlock" 
                       Text="" 
                       Margin="0,10,0,0"
                       FontStyle="Italic"
                       TextWrapping="Wrap"/>
		</Grid>

		<!-- Buttons -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button x:Name="CancelButton" Content="Annulla" 
                    Click="CancelButton_Click"
                    Background="{StaticResource PanelBrush}"
                    Margin="0,0,10,0"/>
			<Button x:Name="ConnectButton" Content="Connetti" 
                    Click="ConnectButton_Click"
                    Width="120"/>
		</StackPanel>
	</Grid>
</Window>
