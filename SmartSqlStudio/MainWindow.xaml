<Window x:Class="SmartSQLStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart SQL Studio" 
        Height="800" Width="1400"
        WindowState="Maximized">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0" Background="{StaticResource PanelBrush}">
            <ToolBar BandIndex="0">
                <Button x:Name="NewTabButton" Click="NewTabButton_Click" ToolTip="Nuova Query (Ctrl+T)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" Margin="0,0,5,0"/>
                        <TextBlock Text="Nuova Query"/>
                    </StackPanel>
                </Button>
                
                <Separator/>
                
                <Button x:Name="ExecuteButton" Click="ExecuteButton_Click" ToolTip="Esegui Query (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶️" Margin="0,0,5,0"/>
                        <TextBlock Text="Esegui"/>
                    </StackPanel>
                </Button>
                
                <Separator/>
                
                <TextBlock Text="Cerca Snippet:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox x:Name="SearchSnippetTextBox" Width="200" 
                         TextChanged="SearchSnippetTextBox_TextChanged"
                         ToolTip="Cerca tra gli snippet disponibili"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Database Explorer -->
            <GroupBox Grid.Column="0" Header="🗄️ Esplora Database" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TreeView x:Name="DatabaseTreeView" 
                              MouseDoubleClick="DatabaseTreeView_MouseDoubleClick"
                              Background="{StaticResource PanelBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </GroupBox>

            <!-- Center Panel - Query Editor with Tabs -->
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- Tab Control per le query -->
                <TabControl x:Name="MainTabControl" Grid.Row="0">
                    <TabControl.Style>
                        <Style TargetType="TabControl">
                            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                        </Style>
                    </TabControl.Style>
                </TabControl>

                <!-- Results Panel -->
                <TabControl Grid.Row="1" x:Name="ResultsTabControl">
                    <TabItem x:Name="ResultTab" Header="📊 Risultati">
                        <DataGrid x:Name="ResultsDataGrid" 
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="{StaticResource PanelBrush}"
                                  Foreground="{StaticResource TextBrush}"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  HeadersVisibility="Column"/>
                    </TabItem>
                    <TabItem Header="📝 Messaggi">
                        <TextBox x:Name="MessagesTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource PanelBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderThickness="0"
                                 Padding="10"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Right Panel - Snippets -->
            <GroupBox Grid.Column="2" Header="📋 Snippet SQL" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <ListBox x:Name="SnippetListBox" 
                             MouseDoubleClick="SnippetListBox_MouseDoubleClick"
                             Background="{StaticResource PanelBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" 
                                               Opacity="0.7"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource PanelBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Pronto"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⌨️ Ctrl+Spazio per IntelliSense" Opacity="0.7"/>
                    <TextBlock Text=" | " Opacity="0.7"/>
                    <TextBlock Text="F5 per Eseguire" Opacity="0.7"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
